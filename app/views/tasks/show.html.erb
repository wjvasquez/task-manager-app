<h1><%= @task.title %></h1>

<p><%= @task.description %></p>

<ul>
  <li>Due Time: <%= @task.due_date %></li>
  <li>Status: <%= @task.status %></li>
</ul>

<p><%= link_to "Edit", edit_task_path(@task) %></p>
<p><%= link_to "Delete", task_path(@task), data: {
                  turbo_method: :delete,
                  turbo_confirm: "Deleting task, are you sure?"
                } %>
<p><%= link_to "Back", root_path %></p>
